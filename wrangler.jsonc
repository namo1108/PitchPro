{
  "name": "soccer-live",
  "main": "src/index.js",
  "compatibility_date": "2026-07-10",
  "assets": {
    "directory": "./frontend",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "kv_namespaces": [
    { "binding": "CACHE", "id": "4a82ab329c014cf781586986df945dbc" }
  ],
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "observability": {
    "enabled": true
  }
}
