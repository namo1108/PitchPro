{
  "name": "soccer-live",
  "main": "src/index.js",
  "compatibility_date": "2026-07-10",
  "assets": {
    "directory": "./frontend",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "kv_namespaces": [
    // `wrangler kv namespace create CACHE` 실행 후 나오는 id로 교체
    { "binding": "CACHE", "id": "REPLACE_WITH_KV_NAMESPACE_ID" }
  ],
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "observability": {
    "enabled": true
  }
}
